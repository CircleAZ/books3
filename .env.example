# AZ Books Environment Configuration
# Copy this file to .env and fill in your values

# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
# For development, leave DB_ENGINE empty to use SQLite
DB_ENGINE=
DB_NAME=azbooks
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432

# Cloudinary (media storage for production)
# Sign up free at https://cloudinary.com
# Find your URL at: Dashboard > Product Environment Credentials
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
