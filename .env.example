# =============================================
# AZ Books — Environment Variables Reference
# =============================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
#
# For Render: Set these in Dashboard → Environment
# For GitHub Actions: Set as Repository Secrets

# ── Core Django ──
SECRET_KEY=                           # Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DEBUG=False                           # True for local dev, False for production
ALLOWED_HOSTS=.onrender.com,.circleaz.in,localhost
CSRF_TRUSTED_ORIGINS=https://books.circleaz.in,https://circleaz.in,https://api.circleaz.in
CORS_ALLOWED_ORIGINS=https://books.circleaz.in,https://circleaz.in

# ── Database (Neon PostgreSQL — Singapore) ──
# Use the POOLED connection string for the app (ends in -pooler.*.neon.tech)
# Use the DIRECT connection string for migrations and GitHub Actions backup
DATABASE_URL=postgres://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/azbooks?sslmode=require

# ── Cache (optional — Upstash Redis) ──
# REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379

# ── Cloudflare R2 ──
R2_ENDPOINT_URL=https://{account_id}.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_RECEIPTS_BUCKET=azbooks-receipts

# ── WhatsApp Cloud API (pending SIM card) ──
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=

# ── Receipt Base URL ──
RECEIPT_BASE_URL=https://books.circleaz.in

# ── New Relic APM ──
# NEW_RELIC_LICENSE_KEY=
# NEW_RELIC_APP_NAME=AZBooks

# ── GitHub Actions Secrets (for backup workflow) ──
# These go in GitHub → Settings → Secrets, NOT in .env:
# DB_HOST=ep-xxx.ap-southeast-1.aws.neon.tech    (DIRECT host, not pooler)
# DB_NAME=azbooks
# DB_USER=azbooks_owner
# DB_PASSWORD=xxx
# BACKUP_ENCRYPT_KEY=xxx                          (any strong passphrase)
# R2_BACKUP_ACCESS_KEY_ID=xxx                     (can reuse R2_ACCESS_KEY_ID)
# R2_BACKUP_SECRET_ACCESS_KEY=xxx                 (can reuse R2_SECRET_ACCESS_KEY)
# R2_BACKUP_ENDPOINT=https://{account_id}.r2.cloudflarestorage.com
